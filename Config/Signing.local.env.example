# Copy to Config/Signing.local.env (ignored by git) on the Mac that signs and
# publishes releases. build.sh and publish.sh read it when it exists; nothing
# else needs it. Contributors do not need this file: without it, ./build.sh
# signs the app ad hoc so it runs on the Mac that built it.

# The Developer ID Application certificate in your login keychain, as
# `security find-identity -v -p codesigning` prints its name.
#ESCALE_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"

# The notarytool profile stored once with:
#   xcrun notarytool store-credentials NAME --apple-id YOUR_APPLE_ID --team-id TEAMID1234
# (it asks for an app-specific password and keeps everything in the keychain).
#ESCALE_NOTARY_PROFILE="escale"

# The GitHub repository whose releases receive the DMG, the ZIP and the appcast.
#ESCALE_REPOSITORY="kndpt/escale-browser"

# Where the appcast says the ZIP and DMG are served from. Defaults to this
# version's release on ESCALE_REPOSITORY.
#ESCALE_DOWNLOAD_URL="https://github.com/kndpt/escale-browser/releases/download/v1.0"
